{
  "name": "session-mesh-mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol multi-agent coordination kernel, cross-session mesh, and context firewall.",
  "author": "Shashank Tripathi <shashanktripathi.st15a@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShashankIIITN/session-mesh-mcp.git"
  },
  "homepage": "https://github.com/ShashankIIITN/session-mesh-mcp#readme",
  "bugs": {
    "url": "https://github.com/ShashankIIITN/session-mesh-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "session-mesh-mcp": "dist/index.js",
    "agent-mesh-mcp": "dist/index.js",
    "mcp-agent-orchestrator": "dist/index.js"
  },
  "files": [
    "dist",
    "orchestrator.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "orchestrator",
    "multi-agent",
    "swarm",
    "agent-mesh"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx tests/test-path-utils.ts && tsx tests/test-security.ts && tsx tests/verify-orchestrator.ts && tsx tests/test-session-mesh.ts",
    "test:e2e": "npm run build && tsx tests/test-e2e-stdio.ts",
    "lint": "eslint",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.8.2",
    "yaml": "^2.7.1",
    "zod": "^3.24.4",
    "nanoid": "^5.1.3",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.26.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
