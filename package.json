{
  "name": "session-mesh-mcp",
  "version": "0.2.1",
  "description": "Model Context Protocol multi-agent coordination kernel, cross-session mesh, and context firewall.",
  "author": "Shashank Tripathi <shashanktripathi.st15a@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShashankIIITN/session-mesh-mcp.git"
  },
  "homepage": "https://github.com/ShashankIIITN/session-mesh-mcp#readme",
  "bugs": {
    "url": "https://github.com/ShashankIIITN/session-mesh-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "session-mesh-mcp": "dist/index.js",
    "agent-mesh-mcp": "dist/index.js",
    "mcp-agent-orchestrator": "dist/index.js"
  },
  "files": [
    "dist",
    "orchestrator.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "orchestrator",
    "multi-agent",
    "swarm",
    "agent-mesh"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "node --watch --import ./scripts/ts-loader.mjs src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import ./scripts/ts-loader.mjs tests/test-path-utils.ts && node --import ./scripts/ts-loader.mjs tests/test-security.ts && node --import ./scripts/ts-loader.mjs tests/verify-orchestrator.ts && node --import ./scripts/ts-loader.mjs tests/test-session-mesh.ts",
    "test:e2e": "npm run build && node --import ./scripts/ts-loader.mjs tests/test-e2e-stdio.ts",
    "lint": "eslint",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "yaml": "^2.7.1",
    "zod": "^3.24.4",
    "nanoid": "^5.1.3",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "eslint": "^9.26.0",
    "typescript": "^5.8.3"
  }
}
